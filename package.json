{
  "name": "konys-reservas-app",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de reservas de mesas de Konys Pizza (Bucaramanga)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch --env-file-if-exists=.env server/dev.js",
    "build": "vite build",
    "preview": "vite preview",
    "db:preparar": "node --env-file=.env server/scripts/preparar-bd.js",
    "db:carta": "node --env-file=.env server/scripts/importar-carta.js",
    "crear-admin": "node --env-file=.env server/scripts/crear-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "vite": "^8.3.6"
  }
}
