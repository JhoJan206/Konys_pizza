# Copia este archivo como .env y completa los valores (nunca subas .env a GitHub).

# Cadena de conexión a PostgreSQL de Supabase
# (Supabase > Project Settings > Database > Connection string > Transaction pooler)
DATABASE_URL=postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Clave secreta para firmar los tokens JWT del panel admin (texto largo y aleatorio)
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Puerto de la API en desarrollo
PORT=3001
